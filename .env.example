# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in a key. The server reads it; it is NEVER
# exposed to the browser and is NOT a VITE_ variable.
#
# With NO key set, the app runs on a built-in deterministic `mock` provider, so
# `npm install && npm start` works with zero setup.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini — free tier at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Force a specific provider: gemini | mock. Omit to auto-select
# (gemini when GEMINI_API_KEY is present, otherwise mock).
# LLM_PROVIDER=

# Server port (Vite proxies /api here). Defaults to 8787.
# PORT=8787
